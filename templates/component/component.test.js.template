/**
 * Note: Running component tests requires Vitest, @avenx/vite and a DOM
 * environment (happy-dom).
 * Vitest needs Node ^22.12, ^24 or >=26.
 *
 * Setup instructions:
 * 1. Install dependencies:
 *      npm install -D vitest @avenx/vite happy-dom
 * 2. Ensure vitest.config.js includes:
 *      import { defineConfig } from 'vitest/config';
 *      import avenx from '@avenx/vite';
 *      export default defineConfig({
 *        plugins: [avenx()],
 *        test: { environment: 'happy-dom' },
 *      });
 * 3. Run:
 *      npx vitest run
 */

import { describe, it, expect } from 'vitest';
import { mountTestComponent, fireEvent } from 'avenx-core/testing';
import {{PascalCaseName}} from './{{name}}.component.js';

describe('{{PascalCaseName}} Component', () => {
  it('renders successfully with default state', async () => {
    const { find } = await mountTestComponent({{PascalCaseName}}, {
      props: { name: '{{PascalCaseName}}' }
    });

    const title = find('h1');
    expect(title.textContent).toMatch(/{{PascalCaseName}} Component/);

    const text = find('p');
    expect(text.textContent).toMatch(/Current count: 0/);
  });

  it('increments count on click', async () => {
    const { find, findAll } = await mountTestComponent({{PascalCaseName}}, {
      props: { name: '{{PascalCaseName}}' }
    });

    const buttons = findAll('button');
    await fireEvent(buttons[0], 'click');

    const text = find('p');
    expect(text.textContent).toMatch(/Current count: 1/);
  });
});