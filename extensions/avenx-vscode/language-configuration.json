{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["<", ">"]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    },
    {
      "open": "`",
      "close": "`"
    },
    {
      "open": "<@",
      "close": ">"
    }
  ],
  "surroundingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "'",
      "close": "'"
    },
    {
      "open": "`",
      "close": "`"
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*<(?!\\/?(?:@(?:css|global)|[A-Za-z][A-Za-z0-9:_-]*)\\b)[^>]+>[^<]*$",
    "decreaseIndentPattern": "^\\s*</(?:@(?:css|global)|[A-Za-z][A-Za-z0-9:_-]*)>\\s*$"
  }
}
