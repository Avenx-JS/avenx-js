{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Avenx project configuration",
  "description": "Generated by npm run generate:config-schema from CONFIG_SCHEMA. Do not edit by hand.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor schema reference; ignored by the compiler."
    },
    "srcDir": {
      "type": "string",
      "minLength": 1,
      "default": "src",
      "description": "Relative application source directory."
    },
    "distDir": {
      "type": "string",
      "minLength": 1,
      "default": "dist",
      "description": "Relative build output directory."
    },
    "templatesDir": {
      "type": "string",
      "minLength": 1,
      "default": ".avenxtemplates",
      "description": "Relative directory for scaffold overrides."
    },
    "scaffold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test": {
          "type": "boolean",
          "default": false,
          "description": "Generate colocated component tests unless --no-test is supplied."
        },
        "style": {
          "type": "boolean",
          "default": true,
          "description": "Generate component and page stylesheets unless --no-style is supplied."
        },
        "template": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Default custom scaffold template; --template takes precedence."
        }
      }
    },
    "mode": {
      "anyOf": [
        {
          "enum": [
            "production",
            "development"
          ]
        },
        {
          "type": "string",
          "pattern": "^\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?$"
        }
      ],
      "default": "production",
      "description": "Build mode; command-line mode flags take precedence."
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            {
              "type": "string",
              "pattern": "^\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?$"
            }
          ],
          "default": 3000,
          "description": "Development server port; 0 lets the operating system choose."
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "default": "localhost",
          "description": "Development server bind address."
        },
        "https": {
          "type": "boolean",
          "default": false,
          "description": "Serve HTTPS using server.cert and server.key."
        },
        "cert": {
          "type": "string",
          "pattern": "\\S",
          "description": "Development TLS certificate path, relative to the project root or absolute."
        },
        "key": {
          "type": "string",
          "pattern": "\\S",
          "description": "Development TLS private-key path, relative to the project root or absolute."
        },
        "liveReload": {
          "type": "boolean",
          "default": true,
          "description": "Watch files and reload the browser."
        },
        "errorOverlay": {
          "type": "boolean",
          "default": true,
          "description": "Display build diagnostics in the browser."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "description": "Custom development server response headers."
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preprocessor": {
          "anyOf": [
            {
              "enum": [
                "none",
                "sass",
                "scss",
                "less",
                "postcss"
              ]
            },
            {
              "type": "string",
              "pattern": "^\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?$"
            }
          ],
          "default": "none",
          "description": "CSS preprocessor, installed separately when needed."
        },
        "sourceMap": {
          "type": "boolean",
          "description": "Generate stylesheet source maps."
        },
        "inlineSourceMap": {
          "type": "boolean",
          "description": "Embed stylesheet source maps."
        },
        "dev": {
          "type": "boolean",
          "description": "Enable development stylesheet output."
        }
      }
    },
    "debug": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "debugReactivity": {
          "type": "boolean",
          "default": false,
          "description": "Log reactive dependency activity."
        }
      }
    },
    "outputName": {
      "type": "string",
      "minLength": 1,
      "default": "bundle",
      "description": "Base filename for generated assets, without an extension."
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "anyOf": [
            {
              "enum": [
                "trace",
                "debug",
                "info",
                "warn",
                "error",
                "fatal",
                "off",
                "silent"
              ]
            },
            {
              "type": "string",
              "pattern": "^\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?$"
            }
          ],
          "default": "info",
          "description": "Minimum log severity."
        },
        "silent": {
          "type": "boolean",
          "default": false,
          "description": "Suppress all logging."
        }
      }
    },
    "voidTags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "Additional self-closing element names."
    },
    "templateGlobals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "default": [],
      "description": "Names supplied to templates by plugins."
    },
    "warnings": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "enum": [
              "off",
              "ignore",
              "warn",
              "warning",
              "error"
            ]
          },
          {
            "type": "string",
            "pattern": "^\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?$"
          }
        ]
      },
      "description": "Warning severity overrides, keyed by canonical diagnostic code."
    },
    "treeShakeComponents": {
      "type": "boolean",
      "default": true,
      "description": "Omit unused components from the bundle."
    },
    "codeSplitting": {
      "type": "boolean",
      "default": false,
      "description": "Emit separate page chunks."
    },
    "preprocessors": {
      "type": "object",
      "description": "Template preprocessors; functions can only be configured through the JavaScript API."
    },
    "alias": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Import prefix to target path mappings."
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prebuild": {
          "type": "string",
          "description": "Synchronous shell command run before a build."
        },
        "postbuild": {
          "type": "string",
          "description": "Synchronous shell command run after a successful build."
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "redact": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "Property path patterns withheld from traces."
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Trace ring-buffer capacity; 0 uses the recorder default."
        }
      }
    },
    "rewind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "onConflict": {
          "anyOf": [
            {
              "enum": [
                "safe",
                "force",
                "abort"
              ]
            },
            {
              "type": "string",
              "pattern": "^\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?$"
            }
          ],
          "default": "safe",
          "description": "Policy for conflicting state changes during rewind."
        },
        "maxSnapshotItems": {
          "type": "integer",
          "minimum": 1,
          "default": 10000,
          "description": "Maximum snapshot collection items."
        }
      }
    },
    "csp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strict": {
          "type": "boolean",
          "default": false,
          "description": "Reject build output requiring unsafe-eval."
        }
      }
    },
    "expressionCacheCapacity": {
      "type": "integer",
      "minimum": 1,
      "default": 1000,
      "description": "Maximum compiled-expression cache entries."
    },
    "sourceMap": {
      "type": "boolean",
      "description": "Generate source maps."
    },
    "sourcesContent": {
      "type": "boolean",
      "default": true,
      "description": "Include original sources in source maps."
    },
    "incremental": {
      "type": "boolean",
      "default": false,
      "description": "Reuse unchanged compilation units."
    }
  }
}
