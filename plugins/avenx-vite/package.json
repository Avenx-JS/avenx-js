  ],
  "author": "Avenx Team",
  "license": "MIT",
  "scripts": {
    "pretest": "node ../../scripts/link-plugin-core.js",
    "test": "node test/vite.test.js"
  },
  "peerDependencies": {
    "vite": "^7.0.0 || ^8.0.0",
    "avenx-core": "^1.0.0-rc.1"
