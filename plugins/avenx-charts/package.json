{
  "name": "@avenx/charts",
  "version": "0.1.0",
  "description": "First-class official declarative, reactive charts plugin for Avenx.js",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
